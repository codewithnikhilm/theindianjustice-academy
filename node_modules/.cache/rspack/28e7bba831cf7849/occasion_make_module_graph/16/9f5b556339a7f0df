  margin-bottom: 2rem;
}

/* Section heading with editorial rules */
main h2[style] {
  font-size: 1rem !important;
  font-family: var(--ifm-font-family-base) !important;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.22em;
  color: var(--ija-muted);
  display: flex;
  align-items: center;
  gap: 1.25rem;
  margin-bottom: 2.25rem !important;
}

main h2[style]::before,
main h2[style]::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--ija-rule);
}

/* Subject cards */
main div[style*="border"][style*="border-radius"] {
  position: relative;
  background: var(--ifm-background-surface-color);
  border: 1px solid var(--ija-rule) !important;
  border-radius: 3px !important;
  box-shadow: none !important;
  padding: 1.75rem 1.5rem !important;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.35rem;
  overflow: hidden;
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

main div[style*="border"][style*="border-radius"]::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background: var(--ija-ink);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.28s ease;
}

main div[style*="border"][style*="border-radius"]:hover {
  transform: translateY(-3px);
  border-color: var(--ija-ink) !important;
  box-shadow: 0 14px 28px -18px rgba(0, 0, 0, 0.45) !important;
}

main div[style*="border"][style*="border-radius"]:hover::before {
  transform: scaleX(1);
}

main div[style*="border"][style*="border-radius"] h3 {
  font-size: 1.35rem;
  margin: 0;
}

main div[style*="border"][style*="border-radius"] p {
  color: var(--ija-muted);
  font-size: 0.94rem;
  margin: 0 0 1rem;
}

main div[style*="border"][style*="border-radius"] .button {
  margin-top: auto;
  font-size: 0.8rem;
  padding: 0.45rem 1.1rem;
}

main div[style*="grid"] {
  gap: 1.25rem !important;
}

/* --------------------------------------------------------------------------
   7. Docs shell: sidebar, TOC, pagination
   -------------------------------------------------------------------------- */
.theme-doc-sidebar-container {
  border-right: 1px solid var(--ija-rule) !important;
}

.menu {
  padding: 1.25rem 0.75rem !important;
  font-size: 0.92rem;
}

.menu__link {
  border-radius: 2px;
  color: var(--ija-muted);
  transition:
    color 0.15s ease,
    background-color 0.15s ease;
}

.menu__link:hover {
  background: var(--ija-paper-2);
  color: var(--ija-ink);
}

.menu__link--active,
.menu__link--active:hover {
  background: transparent;
  color: var(--ija-ink);
  font-weight: 600;
  box-shadow: inset 2px 0 0 0 var(--ija-accent);
}

.menu__list-item-collapsible:hover {
  background: var(--ija-paper-2);
}

.table-of-contents {
  font-size: 0.84rem;
  border-left: 1px solid var(--ija-rule);
}

.table-of-contents__link--active {
  color: var(--ija-ink);
  font-weight: 600;
}

.pagination-nav__link {
  border: 1px solid var(--ija-rule);
  border-radius: 2px;
  transition:
    border-color 0.18s ease,
    transform 0.18s ease;
}

.pagination-nav__link:hover {
  border-color: var(--ija-ink);
  transform: translateY(-2px);
}

.pagination-nav__label {
  font-family: var(--ifm-heading-font-family);
  font-weight: 400;
}

.breadcrumbs__item .breadcrumbs__link {
  border-radius: 2px;
  font-size: 0.82rem;
}

/* Cards on generated category index pages */
article .card,
.card {
  border: 1px solid var(--ija-rule);
  border-radius: 3px;
  box-shadow: none;
  transition:
    transform 0.18s ease,
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

article .card:hover,
.card:hover {
  transform: translateY(-3px);
  border-color: var(--ija-ink);
  box-shadow: 0 14px 28px -18px rgba(0, 0, 0, 0.45);
}

/* --------------------------------------------------------------------------
   8. Footer
   -------------------------------------------------------------------------- */
.footer {
  border-top: 1px solid var(--ija-rule);
  --ifm-footer-link-color: #b8b2a8;
  --ifm-footer-title-color: #f5f3ee;
}

.footer__title {
  font-family: var(--ifm-heading-font-family);
  font-weight: 400;
  font-size: 1.05rem;
  letter-spacing: 0.02em;
}

.footer__link-item:hover {
  color: #fff;
}

/* --------------------------------------------------------------------------
   9. Misc
   -------------------------------------------------------------------------- */
::selection {
  background: var(--ija-ink);
  color: var(--ija-paper);
}

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {
  background: var(--ija-paper);
}

::-webkit-scrollbar-thumb {
  background: var(--ija-rule);
  border-radius: 0;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--ija-muted);
}

@media (prefers-reduced-motion: reduce) {
  * {
    animation: none !important;
    transition: none !important;
  }
}

/* Footer: Infima's dark variant sets its own background â€” force ink. */
.footer.footer--dark {
  --ifm-footer-background-color: var(--ija-ink);
  background-color: var(--ija-ink);
}

[data-theme="dark"] .footer.footer--dark {
  background-color: #0a0908;
}

/* --------------------------------------------------------------------------
   12. Author portrait on the intro page
   -------------------------------------------------------------------------- */
.markdown img[alt^="Nikhil M"] {
  float: right;
  width: 190px;
  max-width: 42%;
  margin: 0.25rem 0 1.25rem 1.75rem;
  border: 1px solid var(--ija-rule);
  border-radius: 3px;
  box-shadow: 6px 6px 0 0 var(--ija-paper-2);
}

.markdown img[alt^="Nikhil M"] + p + ul {
  overflow: hidden;
}

@media (max-width: 600px) {
  .markdown img[alt^="Nikhil M"] {
    float: none;
    display: block;
    width: 160px;
    max-width: 60%;
    margin: 0 0 1.25rem;
  }
}
