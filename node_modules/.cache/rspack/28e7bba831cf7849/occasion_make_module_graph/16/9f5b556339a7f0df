  --ifm-link-hover-color: var(--ija-ink);

  --ifm-font-family-base: "Work Sans", ui-sans-serif, system-ui, sans-serif;
  --ifm-heading-font-family: "Instrument Serif", Georgia, "Times New Roman", serif;
  --ifm-heading-font-weight: 400;
  --ifm-font-size-base: 17px;
  --ifm-line-height-base: 1.7;
  --ifm-global-radius: 2px;
  --ifm-code-font-size: 92%;
  --ifm-navbar-shadow: none;
  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.07);
}

[data-theme="dark"] {
  --ija-paper: #131211;
  --ija-paper-2: #1c1a18;
  --ija-ink: #f5f3ee;
  --ija-ink-soft: #ddd8cf;
